# Copie este arquivo para ".env.local" durante testes locais,
# OU configure estas variáveis no painel da Vercel (Settings > Environment Variables).

# --- OBRIGATÓRIAS ---

# Senha de acesso ao Painel da equipe
TEAM_PASSWORD=teamshakers

# Chave da API do Resend (cria em https://resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Para onde os briefings são enviados
DESIGNER_EMAIL=maria.brito@shakersagencia.com.br


# --- RECOMENDADAS ---

# Remetente do email. Enquanto não verificar um domínio no Resend,
# use o remetente de teste abaixo. Depois troque para algo @seudominio.
FROM_EMAIL=Briefing Shakers <onboarding@resend.dev>

# Segredo da sessão do painel — troque por uma frase aleatória qualquer.
SESSION_SECRET=troque-isto-por-uma-frase-aleatoria-longa


# --- AUTOMÁTICAS (criadas pela Vercel ao adicionar o KV) ---
# Não precisa preencher à mão: ao criar o banco KV no painel da Vercel,
# estas variáveis aparecem sozinhas no projeto.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
